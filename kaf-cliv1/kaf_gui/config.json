{
  "kaf_cli_path": "",
  "output_dir": "",
  "format": "epub",
  "lang": "zh",
  "align": "center",
  "indent": 2,
  "bottom": "1em",
  "line_height": "1.5rem",
  "separate_chapter_number": false,
  "tips": false,
  "zh_conversion": "none",
  "theme": "light",
  "auto_open_folder": true,
  "cover_mode": "orly",
  "custom_cover_path": "",
  "orly_color": "",
  "orly_idx": -1,
  "css_preset": "預設樣式 (Kaf 預設)",
  "custom_css_file": "",
  "font_path": "",
  "match_regex": "^作者:.+?日期:",
  "enable_volume": true,
  "volume_regex": "^第[0-9一二三四五六七八九十零〇百千两 ]+[卷部]",
  "exclude_regex": "^第[0-9一二三四五六七八九十零〇百千两 ]+(部門|部队|部属|部分|部件|部落|部.*：$)",
  "max_title_len": 60,
  "unknow_title": "章節正文",
  "user_presets": {}
}